# Copy to .env (never commit .env). Export these before starting uvicorn, e.g.
#   set -a; source .env; set +a; uvicorn app.main:app --host 0.0.0.0 --port 8000

# mock  = return clearly labelled fixtures (no model involved)
# proxy = forward validated requests to your real model services
ATHERA_GATEWAY_MODE=mock

# Optional. If set, the mobile app must send it as the X-API-Key header.
# ATHERA_API_KEY=change-me

# Mock mode only: normal | early_warning | critical | unknown
ATHERA_MOCK_RISK_CLASS=normal

# Proxy mode only. These stay on the server and are never sent to the app.
# ATHERA_UPSTREAM_FORECAST_URL=https://lstm.internal.example/predict
# ATHERA_UPSTREAM_RISK_URL=https://xgb.internal.example/classify
# ATHERA_UPSTREAM_API_KEY=change-me
# ATHERA_UPSTREAM_TIMEOUT_SECONDS=10

# Contract limits (must match what your models were trained for)
ATHERA_SUPPORTED_HORIZONS=300,600,1800
ATHERA_MIN_WINDOW_SIZE=10
ATHERA_MAX_WINDOW_SIZE=1440
ATHERA_MIN_COMPLETENESS=0.5
ATHERA_LOG_LEVEL=INFO
